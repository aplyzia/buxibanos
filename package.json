{
  "name": "eddyflow",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "ts:check": "tsc --noEmit",
    "check-ui": "node --experimental-strip-types scripts/check-ui.ts",
    "onboard-school": "node --experimental-strip-types scripts/onboard-school.ts",
    "import-school": "node --experimental-strip-types scripts/import-school.ts",
    "scan-docs": "node --experimental-strip-types scripts/scan-school-docs.ts",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|nativewind|zustand)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "setup\\.ts$"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.63",
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@livekit/react-native": "^2.9.6",
    "@livekit/react-native-expo-plugin": "^1.0.1",
    "@livekit/react-native-webrtc": "^137.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@soniox/client": "^1.0.2",
    "@supabase/supabase-js": "^2.49.1",
    "base64-arraybuffer": "^1.0.2",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^24.2.2",
    "livekit-client": "^2.17.3",
    "lucide-react-native": "^0.575.0",
    "nativewind": "4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.4.1",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "googleapis": "^171.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "mammoth": "^1.12.0",
    "open": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.58.2",
    "react-test-renderer": "^19.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  }
}
